# Local development defaults. Copy to .env at the repository root.
FV_ENVIRONMENT=development
FV_DATABASE_URL=sqlite:///./data/failureverse.db
FV_DEMO_HEALTH_URL=http://127.0.0.1:5001/health
FV_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
FV_CHECK_TIMEOUT_SECONDS=2
FV_HISTORY_LIMIT=120
# Phase 2: local native tool calling; no paid provider required.
FV_AI_ENABLED=true
FV_OLLAMA_BASE_URL=http://127.0.0.1:11434
FV_OLLAMA_MODEL=qwen3:0.6b
FV_MODEL_TIMEOUT_SECONDS=120
FV_DIAGNOSTICS_BASE_URL=http://127.0.0.1:8020
# Broker only; exact container allowlist plus all three test labels are required.
FV_DEMO_CONTAINER_NAME=failureverse-ai-demo-app-1
# Docker Desktop socket group; on Linux set to the actual socket GID.
FV_DOCKER_GID=0
# Hard ceilings are code-enforced: 4 model calls, 6 tool calls, 180 seconds.
# Optional future cloud provider; keep real credentials out of Git.
FV_CLOUD_API_KEY=
