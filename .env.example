# Local development defaults. Copy to .env at the repository root.
FV_ENVIRONMENT=development
FV_DATABASE_URL=sqlite:///./data/failureverse.db
FV_DEMO_HEALTH_URL=http://127.0.0.1:5001/health
FV_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
FV_CHECK_TIMEOUT_SECONDS=2
FV_HISTORY_LIMIT=120
# Reserved for Phase 2; Phase 1 makes no model calls.
FV_OLLAMA_BASE_URL=http://127.0.0.1:11434
FV_OLLAMA_MODEL=qwen3:8b
# Optional future cloud provider; keep real credentials out of Git.
FV_CLOUD_API_KEY=
